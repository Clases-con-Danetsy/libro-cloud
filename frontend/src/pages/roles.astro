---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro";
---

<MainLayout title="Roles">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">

          <div class="flex justify-end mb-4">
            <a
              href="/roles_create"
              class="bg-pink-500 text-white px-5 py-2 rounded-full hover:bg-pink-600 transition"
            >
              + Agregar Rol
            </a>
          </div>

          <h1 class="text-3xl font-bold mb-8">Roles</h1>

          <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full leading-normal">
              <thead>
                <tr>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">ID</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Nombre</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado por</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado por</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Estado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Acciones</th>
                </tr>
              </thead>

              <tbody id="roles-table-body"></tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <div
    id="confirm-modal"
    class="fixed inset-0 hidden items-center justify-center z-50 bg-black/40 backdrop-blur-sm"
  >
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8">
      <h2 class="text-xl font-semibold mb-4">Confirmar acción</h2>
      <p class="mb-6">¿Deseas desactivar este rol?</p>

      <div class="flex justify-end gap-3">
        <button onclick="closeModal()" class="cursor-pointer px-5 py-2 border rounded-full">
          Cancelar
        </button>
        <button onclick="confirmDeactivate()" class="cursor-pointer px-5 py-2 bg-pink-500 text-white rounded-full">
          Desactivar
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  let roleToDeactivate = null;

  function formatDate(dateString) {
    if (!dateString) return "";
    const date = new Date(dateString);
    return date.toLocaleString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function editRole(id) {
    window.location.href = `/roles_update?id=${id}`;
  }

  async function activateRole(id) {
    await fetch(`http://localhost:8000/roles/${id}/activate`, { method: "PUT" });
    loadRoles();
  }

  function deactivateRole(id) {
    roleToDeactivate = id;
    document.getElementById("confirm-modal").classList.remove("hidden");
    document.getElementById("confirm-modal").classList.add("flex");
  }

  function closeModal() {
    roleToDeactivate = null;
    document.getElementById("confirm-modal").classList.add("hidden");
    document.getElementById("confirm-modal").classList.remove("flex");
  }

  async function confirmDeactivate() {
    await fetch(`http://localhost:8000/roles/${roleToDeactivate}`, {
      method: "DELETE",
    });
    closeModal();
    loadRoles();
  }

  async function loadRoles() {
    const res = await fetch("http://localhost:8000/roles");
    const roles = await res.json();

    const tbody = document.getElementById("roles-table-body");
    tbody.innerHTML = "";

    roles.forEach((r) => {
      tbody.innerHTML += `
        <tr class="hover:bg-gray-50">
          <td class="px-5 py-4 border-b">${r.id}</td>
          <td class="px-5 py-4 border-b">${r.nombre}</td>
          <td class="px-5 py-4 border-b">${formatDate(r.created_at)}</td>
          <td class="px-5 py-4 border-b">${formatDate(r.updated_at)}</td>
          <td class="px-5 py-4 border-b">${r.created_by || "-"}</td>
          <td class="px-5 py-4 border-b">${r.updated_by || "-"}</td>

          <td class="px-5 py-4 border-b">
            <span class="px-3 py-1 rounded-full text-xs font-semibold
              ${
                r.status
                  ? "border border-green-500 text-green-600 bg-green-50"
                  : "border border-red-500 text-red-600 bg-red-50"
              }">
              ${r.status ? "Activo" : "Inactivo"}
            </span>
          </td>

          <td class="px-5 py-4 border-b">
            <div class="flex gap-4 items-center">

              <!-- EDITAR -->
              <span onclick="editRole(${r.id})" class="cursor-pointer text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M11 5h2M5 19l4-1 9-9-3-3-9 9-1 4z" />
                </svg>
              </span>

              <!-- ACTIVAR -->
              <span onclick="activateRole(${r.id})" class="cursor-pointer text-green-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M5 13l4 4L19 7" />
                </svg>
              </span>

              <!-- DESACTIVAR -->
              <span onclick="deactivateRole(${r.id})" class="cursor-pointer text-red-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>

            </div>
          </td>
        </tr>
      `;
    });
  }

  loadRoles();
</script>
