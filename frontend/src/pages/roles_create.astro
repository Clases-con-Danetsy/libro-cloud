---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro";
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
---

<MainLayout title="Agregar Rol">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-xl mx-auto bg-white shadow-md rounded-lg p-8">
          <h1 class="text-2xl font-bold mb-6">Agregar Rol</h1>

          <form id="rol-form" class="space-y-6">
            <!-- Nombre -->
            <div>
              <label class="block text-sm font-medium mb-1">Nombre</label>
              <input
                id="nombre"
                type="text"
                class="w-full border rounded-md px-3 py-2"
                placeholder="Ej. Administrador"
                required
              />
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
              <button
                type="submit"
                class="cursor-pointer bg-pink-500 text-white px-4 py-2 rounded-md hover:bg-pink-600 transition"
              >
                Guardar
              </button>

              <a
                href="/roles"
                class="cursor-pointer px-4 py-2 rounded-md border border-gray-300 hover:bg-gray-100"
              >
                Cancelar
              </a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script type="module" define:vars={{ API_BASE_URL }}>
  const { loggedUserId, rol_id } = window.Verificacion.getUserData();
  const form = document.getElementById("rol-form");
  const nombreInput = document.getElementById("nombre");

  const usuarioActual = localStorage.getItem("user");
  const usuarioActualId = JSON.parse(usuarioActual).id;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const res = await fetch(`${API_BASE_URL}/roles`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${localStorage.getItem("access_token")}`,
      },
      body: JSON.stringify({
        nombre: nombreInput.value,
        user_id: usuarioActualId,
      }),
    });

    if (res.ok) {
      alert("Rol creado correctamente");
      window.location.href = "/roles";
    } else {
      alert("Error al crear el rol");
    }
  });
  window.onload = function () {
    console.log(rol_id);
    if (window.Verificacion.canCreate(rol_id)) {
      alert("No tienes permiso para crear este rol");
      window.location.href = "/roles";
    }
  };
</script>
