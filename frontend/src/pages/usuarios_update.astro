---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/menu.astro";
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;  // ✅ AGREGADO
---

<MainLayout title="Editar Usuario">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-xl mx-auto bg-white shadow-md rounded-lg p-8">
          <h1 class="text-2xl font-bold mb-6">Editar Usuario</h1>

          <form id="usuario-form" class="space-y-6">
            <!-- Usuario -->
            <div>
              <label class="block text-sm font-medium mb-1">Usuario</label>
              <input
                id="username"
                type="text"
                class="w-full border rounded-md px-3 py-2"
                required
              />
            </div>

            <!-- Rol -->
            <div>
              <label class="block text-sm font-medium mb-1">Rol</label>
              <select
                id="rol"
                class="w-full border rounded-md px-3 py-2"
                required></select>
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
              <button
                type="submit"
                class="cursor-pointer bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700"
              >
                Guardar cambios
              </button>

              
                href="/usuarios"
                <a
                class="px-4 py-2 rounded-md border border-gray-300 hover:bg-gray-100"
              >
                Cancelar
              </a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script type="module" define:vars={{ API_BASE_URL }}>
  const params = new URLSearchParams(window.location.search);
  const userId = params.get("id");

  if (!userId) {
    alert("ID de usuario no encontrado");
    window.location.href = "/usuarios";
  }

  const usernameInput = document.getElementById("username");
  const rolSelect = document.getElementById("rol");
  const form = document.getElementById("usuario-form");
  const usuarioActual = localStorage.getItem("user");
  const usuarioActualId = JSON.parse(usuarioActual).id;

  // 🔹 cargar roles
  async function loadRoles(selectedRolId) {
    const res = await fetch(`${API_BASE_URL}/roles`, {  // ✅ CORREGIDO
      headers: {
        Authorization: `Bearer ${localStorage.getItem("access_token")}`,
      },
    });
    const roles = await res.json();

    rolSelect.innerHTML = "";

    roles.forEach((r) => {
      const option = document.createElement("option");
      option.value = r.id;
      option.textContent = r.nombre;

      if (r.id === selectedRolId) {
        option.selected = true;
      }

      rolSelect.appendChild(option);
    });
  }

  // 🔹 cargar usuario por ID
  async function loadUsuario() {
    const res = await fetch(`${API_BASE_URL}/usuarios/${userId}`, {  // ✅ CORREGIDO
      headers: {
        Authorization: `Bearer ${localStorage.getItem("access_token")}`,
      },
    });

    if (!res.ok) {
      alert("No se pudo cargar el usuario");
      return;
    }

    const usuario = await res.json();

    usernameInput.value = usuario.username;

    await loadRoles(usuario.rol_id);
  }

  // 🔹 enviar actualización
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const loggedUserId = localStorage.getItem("user_id");

    if (!loggedUserId) {
      alert("No se pudo obtener el ID del usuario logueado");
      return;
    }

    try {
      const res = await fetch(`${API_BASE_URL}/usuarios/${userId}`, {  // ✅ CORREGIDO
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${localStorage.getItem("access_token")}`,
        },
        body: JSON.stringify({
          username: usernameInput.value,
          rol_id: Number(rolSelect.value),
          updated_by: Number(loggedUserId),
        }),
      });

      if (res.ok) {
        alert("Usuario actualizado correctamente");
        window.location.href = "/usuarios";
      } else {
        const errorData = await res.json();
        console.error("Error del servidor:", errorData);
        alert(
          "Error al actualizar usuario: " +
            (errorData.detail || "Error desconocido"),
        );
      }
    } catch (error) {
      console.error("Error:", error);
      alert("Error de conexión al actualizar usuario");
    }
  });

  loadUsuario();
</script>