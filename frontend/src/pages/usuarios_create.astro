---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro";
---

<MainLayout title="Crear Usuario">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-xl mx-auto bg-white shadow-md rounded-lg p-8">
          <h1 class="text-2xl font-bold mb-6">Crear Usuario</h1>

          <form id="usuario-form" class="space-y-6">
            <!-- Usuario -->
            <div>
              <label class="block text-sm font-medium mb-1">Usuario</label>
              <input
                id="username"
                type="text"
                class="w-full border rounded-md px-3 py-2"
                required
              />
            </div>

            <!-- Password -->
            <div>
              <label class="block text-sm font-medium mb-1">Contraseña</label>
              <input
                id="password"
                type="password"
                class="w-full border rounded-md px-3 py-2"
                required
              />
            </div>

            <!-- Rol -->
            <div>
              <label class="block text-sm font-medium mb-1">Rol</label>
              <select
                id="rol"
                class="w-full border rounded-md px-3 py-2"
                required
              ></select>
            </div>

            <!-- Botones -->
            <div class="flex gap-4">
              <button
                type="submit"
                class="cursor-pointer bg-pink-500 text-white px-5 py-2 rounded-full hover:bg-pink-600 transition"
              >
                Guardar
              </button>

              <a
                href="/usuarios"
                class="px-5 py-2 rounded-full border border-gray-300 hover:bg-gray-100 transition"
              >
                Cancelar
              </a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline>
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  const form = document.getElementById("usuario-form");
  const usernameInput = document.getElementById("username");
  const passwordInput = document.getElementById("password");
  const rolSelect = document.getElementById("rol");

  async function loadRoles() {
    const res = await fetch("http://localhost:8000/roles");
    const roles = await res.json();

    rolSelect.innerHTML = "";

    roles.forEach((r) => {
      const option = document.createElement("option");
      option.value = r.id;
      option.textContent = r.nombre;
      rolSelect.appendChild(option);
    });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const res = await fetch("http://localhost:8000/usuarios", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        username: usernameInput.value,
        password: passwordInput.value,
        rol_id: Number(rolSelect.value),
      }),
    });

    if (res.ok) {
      window.location.href = "/usuarios";
    } else {
      alert("Error al crear el usuario");
    }
  });

  loadRoles();
</script>
