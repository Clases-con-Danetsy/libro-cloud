---
import Layout from "../layouts/layout.astro";
import Menu from "../components/menu.astro";
import Sidebar from "../components/sidebar.astro";
import Button from "@/components/button.astro";
---

<div class="flex gap-3">
  <Button type="submit" variant="default" size="default" id="btnGuardar">
    Crear Rol
  </Button>
  <a href="/roles">
    <Button type="button" variant="outline" size="default"> Cancelar </Button>
  </a>
</div>
<Layout title="Nuevo Usuario">
  <Menu />
  <div class="flex flex-row gap-4">
    <Sidebar />
    <div class="flex-1 p-6">
      <div class="max-w-2xl">
        <h1 class="text-2xl font-bold mb-6">Crear Nuevo Usuario</h1>

        <form id="formUsuario" class="space-y-4">
          <div>
            <label for="Usuario_name" class="block text-sm font-medium mb-2">
              Nombre del Usuario <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="Usuario_name"
              name="Usuario_name"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="Ej: Administrador, Usuario, Editor..."
            />
          </div>

          <div
            id="errorMessage"
            class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded"
          >
          </div>

          <div
            id="successMessage"
            class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded"
          >
          </div>

          <div class="flex gap-3">
            <Button
              type="submit"
              variant="default"
              size="default"
              id="btnGuardar"
            >
              Crear Usuario
            </Button>
            <a href="/Usuarioes">
              <Button type="button" variant="outline" size="default">
                Cancelar
              </Button>
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";

  const form = document.getElementById("formUsuario") as HTMLFormElement;
  const errorMessage = document.getElementById("errorMessage");
  const successMessage = document.getElementById("successMessage");
  const btnGuardar = document.getElementById("btnGuardar");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Limpiar mensajes previos
    errorMessage?.classList.add("hidden");
    successMessage?.classList.add("hidden");

    const formData = new FormData(form);
    const UsuarioName = formData.get("Usuario_name") as string;

    if (!UsuarioName || UsuarioName.trim() === "") {
      if (errorMessage) {
        errorMessage.textContent = "El nombre del Usuario es obligatorio";
        errorMessage.classList.remove("hidden");
      }
      return;
    }

    try {
      // Deshabilitar botón mientras se envía
      if (btnGuardar) {
        btnGuardar.setAttribute("disabled", "true");
        btnGuardar.textContent = "Guardando...";
      }

      const response = await fetch(
        `http://127.0.0.1:8000/Usuario/create?Usuario_name=${encodeURIComponent(UsuarioName)}`,
        {
          method: "POST",
          headers: {
            accept: "application/json",
          },
        },
      );

      const data = await response.json();

      if (response.ok) {
        if (successMessage) {
          successMessage.textContent =
            data.mensaje || "Usuario creado correctamente";
          successMessage.classList.remove("hidden");
        }

        setTimeout(() => {
          navigate("/Usuarioes");
        }, 1500);
      } else {
        throw new Error(data.detail || "Error al crear el Usuario");
      }
    } catch (error) {
      console.error("Error:", error);
      if (errorMessage) {
        errorMessage.textContent =
          error instanceof Error ? error.message : "Error al crear el Usuario";
        errorMessage.classList.remove("hidden");
      }

      if (btnGuardar) {
        btnGuardar.removeAttribute("disabled");
        btnGuardar.textContent = "Crear Usuario";
      }
    }
  });
</script>
