---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro"; // ✅ componente reutilizable
---

<MainLayout title="Dashboard">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <!-- ✅ Menu reutilizable -->
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">
          <!-- 👇 BIENVENIDA BONITA -->
          <div class="bg-white shadow rounded-lg p-6 mb-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">
              Bienvenido
            </h1>

            <p class="text-gray-600">
              Usuario:
              <span id="user-name" class="font-semibold text-gray-800"></span>
            </p>

            <p class="text-gray-600">
              Rol:
              <span
                id="user-role"
                class="inline-block px-3 py-1 ml-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700"
              ></span>
            </p>
          </div>

          <p class="text-gray-500">

          </p>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline>
  // 🔒 Validar sesión
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  // 👇 Obtener usuario del login
  const userRaw = localStorage.getItem("user");

  if (userRaw) {
    const user = JSON.parse(userRaw);

    document.getElementById("user-name").textContent = user.username;
    document.getElementById("user-role").textContent = user.rol_name;
  }
</script>
