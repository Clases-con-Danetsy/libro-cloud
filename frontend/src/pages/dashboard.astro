---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Dashboard">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />
    
    <div class="flex-1 flex flex-col">
      <!-- Top Menu / Header -->
      <header class="bg-white shadow-sm p-4">
        <div class="max-w-7xl mx-auto flex justify-end items-center px-4 sm:px-6 lg:px-8">
           <button
            id="logout-btn"
            class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-150 ease-in-out"
          >
            Cerrar sesión
          </button>
        </div>
      </header>

      <!-- Main Content -->
      <main class="flex-1 p-10">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-3xl font-bold text-gray-800 mb-8">Dashboard</h1>
          <p class="mt-4 text-gray-600">Bienvenido al panel de control.</p>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline>
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  const logoutBtn = document.getElementById("logout-btn");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", () => {
      localStorage.removeItem("isLoggedIn");
      localStorage.removeItem("user");
      window.location.replace("/");
    });
  }
</script>
