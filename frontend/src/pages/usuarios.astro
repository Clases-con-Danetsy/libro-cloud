---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<MainLayout title="Usuarios">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <!-- Top Menu -->
      <header class="bg-white shadow-sm p-4">
        <div class="max-w-7xl mx-auto flex justify-end">
          <button
            id="logout-btn"
            class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded"
          >
            Cerrar sesión
          </button>
        </div>
      </header>

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">
          <h1 class="text-3xl font-bold mb-8">Usuarios</h1>

          <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full leading-normal">
              <thead>
                <tr>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    ID
                  </th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    Usuario
                  </th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    Rol
                  </th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    Creado
                  </th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    Actualizado
                  </th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-left text-xs font-semibold">
                    Estado
                  </th>
                </tr>
              </thead>
              <tbody id="usuarios-table-body">
                <!-- Se llena por fetch -->
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline>
  // Protección de sesión
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  // Logout
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    localStorage.removeItem("isLoggedIn");
    localStorage.removeItem("user");
    window.location.replace("/");
  });

  // Fetch usuarios
  async function loadUsuarios() {
    const response = await fetch("http://localhost:8000/usuarios");
    const usuarios = await response.json();

    const tbody = document.getElementById("usuarios-table-body");
    tbody.innerHTML = "";

    usuarios.forEach(u => {
      tbody.innerHTML += `
        <tr>
          <td class="px-5 py-4 border-b">${u.id}</td>
          <td class="px-5 py-4 border-b">${u.username}</td>
          <td class="px-5 py-4 border-b">${u.rol_name}</td>
          <td class="px-5 py-4 border-b">${u.created_at}</td>
          <td class="px-5 py-4 border-b">${u.updated_at}</td>
          <td class="px-5 py-4 border-b">
            <span class="px-3 py-1 rounded-full text-xs font-semibold
              ${u.is_active
                ? 'border border-green-500 text-green-600 bg-green-50'
                : 'border border-red-500 text-red-600 bg-red-50'}">
              ${u.is_active ? "Activo" : "Inactivo"}
            </span>
          </td>
        </tr>
      `;
    });
  }

  loadUsuarios();
</script>
