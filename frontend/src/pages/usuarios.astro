---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro";
---

<MainLayout title="Usuarios">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">

          <!-- 🔹 BOTÓN AGREGAR USUARIO -->
          <div class="flex justify-end mb-4">
            <a
              href="/usuarios_create"
              class="cursor-pointer bg-pink-500 text-white px-5 py-2 rounded-full hover:bg-pink-600 transition"
            >
              + Agregar Usuario
            </a>
          </div>

          <h1 class="cursor-pointertext-3xl font-bold mb-8">Usuarios</h1>

          <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full leading-normal">
              <thead>
                <tr>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">ID</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Usuario</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Rol</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Estado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Acciones</th>
                </tr>
              </thead>
              <tbody id="usuarios-table-body"></tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- 🌸 MODAL FEMENINO -->
  <div
    id="confirm-modal"
    class="cursor-pointer fixed inset-0 hidden items-center justify-center z-50 bg-black/40 backdrop-blur-sm"
  >
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-pink-500"
            fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M12 18a6 6 0 100-12 6 6 0 000 12z" />
          </svg>
        </div>
        <h2 class="cursor-pointer text-xl font-semibold text-gray-800">
          Confirmar acción
        </h2>
      </div>

      <p class="cursor-pointer text-gray-600 mb-8 leading-relaxed">
        ¿Estás seguro de que deseas desactivar este usuario?
      </p>

      <div class="flex justify-end gap-3">
        <button
          onclick="closeModal()"
          class="cursor-pointer px-5 py-2 rounded-full border border-gray-300 text-gray-600 hover:bg-gray-100 transition"
        >
          Cancelar
        </button>

        <button
          onclick="confirmDeactivate()"
          class="cursor-pointer px-5 py-2 rounded-full bg-pink-500 text-white hover:bg-pink-600 transition"
        >
          Desactivar
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  let userToDeactivate = null;

  function formatDate(dateString) {
    if (!dateString) return "";
    const date = new Date(dateString);
    return date.toLocaleString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function editUser(id) {
    window.location.href = `/usuarios_update?id=${id}`;
  }

  async function activateUser(id) {
    await fetch(`http://localhost:8000/usuarios/${id}/activate`, {
      method: "PUT",
    });
    loadUsuarios();
  }

  function deactivateUser(id) {
    userToDeactivate = id;
    const modal = document.getElementById("confirm-modal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {
    userToDeactivate = null;
    const modal = document.getElementById("confirm-modal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  async function confirmDeactivate() {
    if (!userToDeactivate) return;

    await fetch(`http://localhost:8000/usuarios/${userToDeactivate}`, {
      method: "DELETE",
    });

    closeModal();
    loadUsuarios();
  }

  async function loadUsuarios() {
    const res = await fetch("http://localhost:8000/usuarios");
    const usuarios = await res.json();

    const tbody = document.getElementById("usuarios-table-body");
    tbody.innerHTML = "";

    usuarios.forEach((u) => {
      tbody.innerHTML += `
        <tr class="hover:bg-gray-50">
          <td class="px-5 py-4 border-b">${u.id}</td>
          <td class="px-5 py-4 border-b">${u.username}</td>
          <td class="px-5 py-4 border-b">${u.rol_name}</td>
          <td class="px-5 py-4 border-b">${formatDate(u.created_at)}</td>
          <td class="px-5 py-4 border-b">${formatDate(u.updated_at)}</td>

          <td class="px-5 py-4 border-b">
            <span class="px-3 py-1 rounded-full text-xs font-semibold
              ${
                u.status
                  ? "border border-green-500 text-green-600 bg-green-50"
                  : "border border-red-500 text-red-600 bg-red-50"
              }">
              ${u.status ? "Activo" : "Inactivo"}
            </span>
          </td>

          <td class="px-5 py-4 border-b">
            <div class="flex gap-4 items-center">

              <span onclick="editUser(${u.id})"
                class="cursor-pointer text-blue-600 hover:text-blue-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M11 5h2M5 19l4-1 9-9-3-3-9 9-1 4z" />
                </svg>
              </span>

              <span onclick="activateUser(${u.id})"
                class="cursor-pointer text-green-600 hover:text-green-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M5 13l4 4L19 7" />
                </svg>
              </span>

              <span onclick="deactivateUser(${u.id})"
                class="cursor-pointer text-red-600 hover:text-red-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>

            </div>
          </td>
        </tr>
      `;
    });
  }

  loadUsuarios();
</script>
