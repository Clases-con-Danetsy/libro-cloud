---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/menu.astro";
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
---

<MainLayout title="Usuarios">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">
          <div class="flex justify-end mb-4">
            <a
              href="/usuarios_create"
              class="cursor-pointer bg-pink-500 text-white px-5 py-2 rounded-full hover:bg-pink-600 transition"
            >
              + Agregar Usuario
            </a>
          </div>

          <h1 class="text-3xl font-bold mb-8">Usuarios</h1>

          <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full leading-normal">
              <thead>
                <tr>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">ID</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Usuario</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Rol</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado por</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado por</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Estado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Acciones</th>
                </tr>
              </thead>
              <tbody id="usuarios-table-body"></tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- MODAL -->
  <div
    id="confirm-modal"
    class="fixed inset-0 hidden items-center justify-center z-50 bg-black/40 backdrop-blur-sm"
  >
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8">
      <p class="text-gray-600 mb-8">
        ¿Estás seguro de que deseas desactivar este usuario?
      </p>

      <div class="flex justify-end gap-3">
        <button onclick="closeModal()" class="cursor-pointer px-5 py-2 rounded-full border">
          Cancelar
        </button>
        <button onclick="confirmDeactivate()" class="cursor-pointer px-5 py-2 rounded-full bg-pink-500 text-white">
          Desactivar
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script type="module" define:vars={{ API_BASE_URL }}>
  console.log(API_BASE_URL);
  const loggedUserId = localStorage.getItem("user_id");
  
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  let userToDeactivate = null;

  function formatDate(dateString) {
    if (!dateString) return "";
    const date = new Date(dateString);
    return date.toLocaleString("es-MX");
  }

  function editUser(id) {
    window.location.href = `/usuarios_update?id=${id}`;
  }

  async function activateUser(id) {
    if (!loggedUserId) {
      alert("No se pudo obtener el ID del usuario logueado");
      return;
    }

    try {
      const response = await fetch(
        `${API_BASE_URL}/usuarios/${id}/activate/${loggedUserId}`,
        {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${localStorage.getItem("access_token")}`,
          },
        },
      );

      if (!response.ok) {
        const errorData = await response.json();
        alert(errorData.detail || "No tienes permisos para activar usuarios");
        return;
      }

      const data = await response.json();
      console.log("Usuario activado:", data);

      loadUsuarios();
    } catch (error) {
      console.error("Error:", error);
      alert("No tienes permisos para realizar esta acción");
    }
  }

  function deactivateUser(id) {
    userToDeactivate = id;
    const modal = document.getElementById("confirm-modal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {
    userToDeactivate = null;
    const modal = document.getElementById("confirm-modal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  async function confirmDeactivate() {
    if (!userToDeactivate) return;

    if (!loggedUserId) {
      alert("No se pudo obtener el ID del usuario logueado");
      closeModal();
      return;
    }

    try {
      const response = await fetch(
        `${API_BASE_URL}/usuarios/${userToDeactivate}/${loggedUserId}`,
        {
          method: "DELETE",
          headers: {
            Authorization: `Bearer ${localStorage.getItem("access_token")}`,
          },
        },
      );

      if (!response.ok) {
        const errorData = await response.json();
        alert(errorData.detail || "No tienes permisos para desactivar usuarios");
        closeModal();
        return;
      }

      const data = await response.json();
      console.log("Usuario desactivado:", data);

      closeModal();
      loadUsuarios();
    } catch (error) {
      console.error("Error:", error);
      alert("No tienes permisos para realizar esta acción");
      closeModal();
    }
  }

  async function loadUsuarios() {
    try {
      const res = await fetch(`${API_BASE_URL}/usuarios`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("access_token")}`,
        },
      });

      if (!res.ok) {
        throw new Error("Error al cargar usuarios");
      }

      const users = await res.json();

      const tbody = document.getElementById("usuarios-table-body");
      tbody.innerHTML = "";

      users.forEach((u) => {
        tbody.innerHTML += `
          <tr>
            <td class="px-5 py-4 border-b">${u.id}</td>
            <td class="px-5 py-4 border-b">${u.username}</td>
            <td class="px-5 py-4 border-b">${u.rol_name}</td>
            <td class="px-5 py-4 border-b">${formatDate(u.created_at)}</td>
            <td class="px-5 py-4 border-b">${formatDate(u.updated_at)}</td>
            <td class="px-5 py-4 border-b">${u.created_by ?? "-"}</td>
            <td class="px-5 py-4 border-b">${u.updated_by ?? "-"}</td>
            <td class="px-5 py-4 border-b">
              <span class="px-3 py-1 rounded-full text-xs font-semibold ${
                u.status
                  ? "border border-green-500 text-green-600 bg-green-50"
                  : "border border-red-500 text-red-600 bg-red-50"
              }">
                ${u.status ? "Activo" : "Inactivo"}
              </span>
            </td>
            <td class="px-5 py-4 border-b">
              <div class="flex gap-4 items-center">
                <span onclick="editUser(${u.id})" class="cursor-pointer text-blue-600" title="Editar">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M11 5h2M5 19l4-1 9-9-3-3-9 9-1 4z" />
                  </svg>
                </span>
                <span onclick="activateUser(${u.id})" class="cursor-pointer text-green-600" title="Activar">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span onclick="deactivateUser(${u.id})" class="cursor-pointer text-red-600" title="Desactivar">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5"
                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </span>
              </div>
            </td>
          </tr>
        `;
      });
    } catch (error) {
      console.error("Error al cargar usuarios:", error);
      alert("No se pudieron cargar los usuarios");
    }
  }

  window.editUser = editUser;
  window.activateUser = activateUser;
  window.deactivateUser = deactivateUser;
  window.closeModal = closeModal;
  window.confirmDeactivate = confirmDeactivate;
  window.loadUsuarios = loadUsuarios;
  
  loadUsuarios();
</script>