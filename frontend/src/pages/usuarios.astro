---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Menu from "../components/Menu.astro"; // ✅ menú reutilizable
---

<MainLayout title="Usuarios">
  <div class="flex min-h-screen bg-gray-100">
    <Sidebar />

    <div class="flex-1 flex flex-col">
      <!-- ✅ MENÚ REUTILIZABLE -->
      <Menu />

      <main class="flex-1 p-10">
        <div class="max-w-6xl mx-auto">
          <h1 class="text-3xl font-bold mb-8">Usuarios</h1>

          <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full leading-normal">
              <thead>
                <tr>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">ID</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Usuario</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Rol</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Creado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Actualizado</th>
                  <th class="px-5 py-3 bg-gray-100 border-b text-xs font-semibold">Estado</th>
                </tr>
              </thead>
              <tbody id="usuarios-table-body"></tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</MainLayout>

<script is:inline>
  if (localStorage.getItem("isLoggedIn") !== "true") {
    window.location.replace("/");
  }

  // ✅ CAMBIO: función para dar formato bonito a fechas
  function formatDate(dateString) {
    if (!dateString) return "";
    const date = new Date(dateString);
    return date.toLocaleString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  async function loadUsuarios() {
    const res = await fetch("http://localhost:8000/usuarios");
    const usuarios = await res.json();

    const tbody = document.getElementById("usuarios-table-body");
    tbody.innerHTML = "";

    usuarios.forEach(u => {
      tbody.innerHTML += `
        <tr>
          <td class="px-5 py-4 border-b">${u.id}</td>
          <td class="px-5 py-4 border-b">${u.username}</td>
          <td class="px-5 py-4 border-b">${u.rol_name}</td>

          <!-- ✅ FECHAS FORMATEADAS -->
          <td class="px-5 py-4 border-b">${formatDate(u.created_at)}</td>
          <td class="px-5 py-4 border-b">${formatDate(u.updated_at)}</td>

          <!-- ✅ ESTADO CON COLORES (NO SE TOCA) -->
          <td class="px-5 py-4 border-b">
            <span class="px-3 py-1 rounded-full text-xs font-semibold
              ${u.status === 1
                ? 'border border-green-500 text-green-600 bg-green-50'
                : 'border border-red-500 text-red-600 bg-red-50'}">
              ${u.status === 1 ? "Activo" : "Inactivo"}
            </span>
          </td>
        </tr>
      `;
    });
  }

  loadUsuarios();
</script>
