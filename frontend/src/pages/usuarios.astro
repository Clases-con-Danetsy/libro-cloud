---
import Layout from "../layouts/layout.astro";
import Menu from "../components/menu.astro";
import Sidebar from "../components/sidebar.astro";
import ModalAlerta from "../components/modalAlerta.astro";
import Button from "@/components/button.astro";
---

<Layout title="Usuarios">
  <Menu />
  <div class="flex flex-row gap-4">
    <Sidebar />
    <div class="flex-1 relative p-6">
      <h1 class="text-2xl font-bold mb-4">Usuarios</h1>
      <div class="absolute top-4 right-6 flex justify-end">
        <a href="./usuario_nuevo">
          <Button variant="default" size="sm"> Nuevo Usuario </Button>
        </a>
      </div>
      <ModalAlerta>
        <slot>Estas seguro de eliminar este usuario?</slot>
      </ModalAlerta>
      <div class="overflow-x-auto">
        <table
          id="usuariosTable"
          class="min-w-full bg-white border border-gray-300"
        >
          <thead>
            <tr class="bg-gray-100 border-b">
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Nombre del Usuario</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Rol</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Estado</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Fecha de Creación</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Última Actualización</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Quien Creó</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Quien Actualizó</th
              >
              <th
                class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
                >Acciones</th
              >
            </tr>
          </thead>
          <tbody id="usuariosBody">
            <!-- Los usuarios se cargarán aquí dinámicamente -->
          </tbody>
        </table>
      </div>

      <div id="loadingMessage" class="text-center p-4 text-gray-600">
        Cargando usuarios...
      </div>

      <div id="emptyMessage" class="hidden text-center p-4 text-gray-500">
        No hay usuarios disponibles
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const errorMessage = document.getElementById("errorMessage");
  const loadingMessage = document.getElementById("loadingMessage");
  const emptyMessage = document.getElementById("emptyMessage");
  const usuariosBody = document.getElementById("usuariosBody");
  const edit = "src/assets/icons/edit.svg";
  const trash = "src/assets/icons/trash.svg";
  const check = "src/assets/icons/check.svg";

  async function getusuarios() {
    const url = new URL("http://localhost:8000/user/get");

    try {
      const response = await fetch(url.toString(), {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const data = await response.json();
      return data;
    } catch (error) {
      if (errorMessage) {
        errorMessage.textContent =
          "Error al conectar con el servidor. Verifica que el backend esté corriendo.";
        errorMessage.classList.remove("hidden");
        errorMessage.classList.add("text-red-600", "bg-red-50");
      }
      console.error("Error:", error);
      throw error;
    }
  }

  function formatDate(dateString) {
    if (!dateString) return "N/A";
    const date = new Date(dateString);
    return date.toLocaleString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  async function mountusuarios() {
    try {
      if (loadingMessage) loadingMessage.classList.remove("hidden");

      const data = await getusuarios();
      if (loadingMessage) loadingMessage.classList.add("hidden");

      // Verifica si data tiene usuarios (ajusta según la estructura de tu respuesta)
      const usuarios = data.usuarios || data.data || data;

      if (!usuarios || usuarios.length === 0 || data.empty) {
        if (emptyMessage) emptyMessage.classList.remove("hidden");
        return;
      }

      if (usuariosBody) {
        usuariosBody.innerHTML = ""; // Limpiar contenido previo

        usuarios.forEach((Usuario, index) => {
          const row = document.createElement("tr");
          row.classList.add(
            "border-b",
            "hover:bg-gray-50",
            "transition-colors",
          );

          // Alterna colores de fila
          if (index % 2 === 0) {
            row.classList.add("bg-white");
          } else {
            row.classList.add("bg-gray-50");
          }

          row.innerHTML = `
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${Usuario.username}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${Usuario.rol}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                Usuario.status === "active" || Usuario.status === 1
                  ? "bg-green-100 text-green-800"
                  : "bg-red-100 text-red-800"
              }">
                ${Usuario.status === "active" || Usuario.status === 1 ? "Activo" : "Inactivo"}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${formatDate(Usuario.created_at)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${formatDate(Usuario.updated_at)}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${Usuario.who_create}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${Usuario.who_update}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <button onclick="editUsuario(${Usuario.id})" class="pr-8 py-2 cursor-pointer rounded-md"><img class="w-5 h-5" src=${edit}></button>
              <button onclick="deleteUsuario(${Usuario.id})" class="pr-8 py-2 cursor-pointer rounded-md"><img class="w-5 h-5" src=${trash}></button>
              <button onclick="activateUsuario(${Usuario.id})" class="pr-8 py-2 cursor-pointer rounded-md"><img class="w-5 h-5" src=${check}></button>
            </td>
          `;

          usuariosBody.appendChild(row);
        });
      }
    } catch (error) {
      if (loadingMessage) loadingMessage.classList.add("hidden");
      console.error("Error al montar usuarios:", error);
    }
  }

  function editUsuario(id) {
    window.location.href = `/usuarios_update?id=${id}`;
  }

  let userToDeleteId = null;

  const btnAceptar = document.getElementById("aceptarconsecuencias");
  const btnCancelar = document.getElementById("cancelarconsecuencias");

  if (btnAceptar) {
    btnAceptar.addEventListener("click", async () => {
      if (!userToDeleteId) return;

      try {
        const url = new URL("http://localhost:8000/user/delete");
        url.searchParams.set("id", userToDeleteId);

        const response = await fetch(url.toString(), {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json",
          },
        });

        // Optional: Check status
        if (response.ok) {
          window.location.reload();
        } else {
          console.error("Error deleting user");
        }
      } catch (error) {
        console.error("Error al eliminar usuario:", error);
      } finally {
        modal.classList.add("hidden");
        userToDeleteId = null;
      }
    });
  }

  if (btnCancelar) {
    btnCancelar.addEventListener("click", () => {
      modal.classList.add("hidden");
      userToDeleteId = null;
    });
  }

  function deleteUsuario(id) {
    userToDeleteId = id;
    modal.classList.remove("hidden");
  }

  async function activateUsuario(id) {
    try {
      const url = new URL("http://localhost:8000/user/activate");
      url.searchParams.set("id", id);

      const response = await fetch(url.toString(), {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const data = await response.json();
      window.location.reload();
    } catch (error) {
      console.error("Error al activar usuario:", error);
    }
  }

  // Ejecutar al cargar la página
  mountusuarios();
</script>
