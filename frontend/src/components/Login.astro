<div class="relative min-h-[80vh] w-full flex items-center justify-center p-4">
  <!-- Elegant background with soft abstract shapes & responsive positioning -->
  <div class="absolute inset-0 overflow-hidden rounded-2xl pointer-events-none">
    <div
      class="absolute -top-[10%] -left-[10%] w-[120%] sm:w-[70%] h-[120%] sm:h-[70%] rounded-full bg-gradient-to-r from-pink-200 to-purple-200 opacity-40 blur-[60px] sm:blur-[80px] animate-pulse"
    >
    </div>
    <div
      class="absolute top-[40%] -right-[10%] w-[100%] sm:w-[60%] h-[100%] sm:h-[60%] rounded-full bg-gradient-to-r from-indigo-200 to-pink-200 opacity-40 blur-[60px] sm:blur-[80px] animate-pulse animation-delay-2000"
    >
    </div>
  </div>

  <!-- Glassmorphism Card - Mobile First Sizing -->
  <div
    class="relative w-full max-w-sm sm:max-w-md lg:max-w-lg p-6 sm:p-8 lg:p-10 bg-white/60 backdrop-blur-xl border border-white/60 rounded-2xl sm:rounded-3xl shadow-[0_8px_32px_0_rgba(31,38,135,0.07)]"
  >
    <div class="text-center mb-8 sm:mb-10">
      <h2
        class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-600 to-purple-600 mb-2"
      >
        Sistema de Biblioteca
      </h2>
      <p class="text-sm sm:text-base text-gray-500 font-medium">
        Bienvenido de nuevo
      </p>
    </div>

    <form id="login-form" class="space-y-5 sm:space-y-6">
      <div class="space-y-3 sm:space-y-4">
        <div>
          <label
            for="username"
            class="block text-sm font-semibold text-gray-600 mb-1 ml-1"
            >Usuario</label
          >
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-3 sm:px-5 sm:py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-pink-500/50 focus:border-pink-500 transition-all duration-200 text-gray-800 placeholder-gray-400 group-hover:bg-white/80 text-sm sm:text-base"
            placeholder="Ej. admin"
          />
        </div>

        <div>
          <label
            for="password"
            class="block text-sm font-semibold text-gray-600 mb-1 ml-1"
            >Contraseña</label
          >
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-4 py-3 sm:px-5 sm:py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-pink-500/50 focus:border-pink-500 transition-all duration-200 text-gray-800 placeholder-gray-400 group-hover:bg-white/80 text-sm sm:text-base"
            placeholder="••••••••"
          />
        </div>
      </div>

      <div
        id="error-message"
        class="hidden p-3 rounded-lg bg-red-50/80 border border-red-100 text-red-500 text-sm text-center font-medium backdrop-blur-sm"
      >
      </div>

      <button
        type="submit"
        class="w-full py-3.5 sm:py-4 px-6 rounded-xl font-bold text-white shadow-lg bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-pink-500 text-sm sm:text-base"
      >
        Iniciar Sesión
      </button>

      <div class="text-center mt-6">
        <span class="text-xs text-gray-400"
          >Sistema de Gestión Bibliotecaria v1.0</span
        >
      </div>
    </form>
  </div>
</div>

<script is:inline>
  const form = document.getElementById("login-form");
  const errorMessage = document.getElementById("error-message");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      // Reset error
      if (errorMessage) {
        errorMessage.classList.add("hidden");
        errorMessage.textContent = "";
      }

      try {
        const response = await fetch("http://127.0.0.1:8000/login", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          // Session logic restored - keeping it simple as requested
          const responseData = await response.json();
          localStorage.setItem("isLoggedIn", "true");
          console.log(responseData);
          if (responseData.user) {
            localStorage.setItem("user", JSON.stringify(responseData.user));
          }
          window.location.replace("/dashboard");
        } else {
          try {
            const result = await response.json();
            const msg = result.detail || JSON.stringify(result);
            if (errorMessage) {
              errorMessage.textContent = msg;
              errorMessage.classList.remove("hidden");
            }
          } catch (jsonError) {
            if (errorMessage) {
              errorMessage.textContent = "Error al procesar la respuesta";
              errorMessage.classList.remove("hidden");
            }
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (errorMessage) {
          errorMessage.textContent =
            "Error de conexión con el servidor backend (http://127.0.0.1:8000)";
          errorMessage.classList.remove("hidden");
        }
      }
    });
  }
</script>
