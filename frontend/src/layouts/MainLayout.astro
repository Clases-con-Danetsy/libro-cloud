---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Libro Cloud" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <slot />
  </body>
</html>
<script is:inline>
  window.Verificacion = {
    getUserData() {
      const loggedUser = JSON.parse(localStorage.getItem("user"));
      if (!loggedUser) {
        return { loggedUserId: null, rol_id: null };
      }
      return {
        loggedUserId: loggedUser.id,
        rol_id: loggedUser.role_id,
      };
    },

    canDeactivate(rol_id) {
      return rol_id > 2;
    },

    canActivate(rol_id) {
      return rol_id > 2;
    },
    canUpdate(rol_id) {
      return rol_id > 1;
    },

    canCreate(rol_id) {
      return rol_id !== 1;
    },
  };
</script>
